{
  "expo": {
    "name": "PollenBee",
    "slug": "polenbee",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "polenbee",
    "userInterfaceStyle": "automatic",
    "locales": {
      "es": "./locales/es.json"
    },
    "ios": {
      "bundleIdentifier": "com.floresstudios.polenbee",
      "supportsTablet": false,
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.floresstudios.polenbee",
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#FBF3E3"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "PollenBee needs access to your photos to analyse the pollen.",
          "cameraPermission": "PollenBee needs access to your camera to photograph your bees."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PollenBee uses your location to know which plants are blooming near your bees."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF3E3",
          "image": "./assets/images/bee-transparent.png",
          "imageWidth": 200
        }
      ],
      "expo-localization",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "98796320-d02e-4c93-a674-3d23f48ca60a"
      }
    }
  }
}
