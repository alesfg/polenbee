{
  "expo": {
    "name": "PolenBee",
    "slug": "polenbee",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "polenbee",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.floresstudios.polenbee",
      "supportsTablet": false,
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.floresstudios.polenbee",
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#FBF3E3"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "PolenBee necesita acceso a tus fotos para analizar el polen.",
          "cameraPermission": "PolenBee necesita acceso a tu cámara para fotografiar las abejas."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PolenBee necesita tu ubicación para identificar el polen de tu zona."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF3E3",
          "image": "./assets/images/icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "98796320-d02e-4c93-a674-3d23f48ca60a"
      }
    }
  }
}
